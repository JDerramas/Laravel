        <footer class="absolute bottom-0 inset-x-0 py-4 text-center">
            <p class="text-[11px] text-white/35 font-mono tracking-wide">© 2026 Navotas Polytechnic College — NPC Connect Academic Portal</p>
        </footer>
    </div>

    <script>
        // ── Supabase & Google Client Configuration ──
        const supabaseUrl = "https:\/\/woscjghjrleqxxyezlyu.supabase.co";
        const supabaseKey = "sb_publishable_hQ8ZDZiqxqPVwqdW5UIPuQ_CrIOmvu4";
        const googleClientId = "8600428144-skbb47hk0klnrcn6u654k4civ5t6nc2o.apps.googleusercontent.com";
        let supabaseClient = null;
        if (typeof supabase !== 'undefined' && typeof supabase.createClient === 'function') {
            try {
                supabaseClient = supabase.createClient(supabaseUrl, supabaseKey);
            } catch(e) {
                console.warn('[Supabase Init Error]', e);
            }
        }

        // ── Google Authentication Controller ──
        const googleModal = document.getElementById('google-account-modal');
        const googleBtn = document.getElementById('google-login-btn');
        const openTestModalBtn = document.getElementById('open-test-modal-btn');
        const closeGoogleBtn = document.getElementById('close-google-modal');
        const overlay = document.getElementById('npc-login-loading');
        const loadingText = document.getElementById('loading-text');

        // Open test account chooser modal
        if (openTestModalBtn && googleModal) {
            openTestModalBtn.addEventListener('click', () => {
                googleModal.classList.remove('hidden');
                googleModal.classList.add('flex');
            });
        }

        // Primary Google Sign-In Button -> Realtime Account Chooser & Gmail Auto-Login
        if (googleBtn && googleModal) {
            googleBtn.addEventListener('click', () => {
                googleModal.classList.remove('hidden');
                googleModal.classList.add('flex');
            });
        }

        if (closeGoogleBtn && googleModal) {
            closeGoogleBtn.addEventListener('click', () => {
                googleModal.classList.add('hidden');
                googleModal.classList.remove('flex');
            });
            googleModal.addEventListener('click', (e) => {
                if (e.target === googleModal) {
                    googleModal.classList.add('hidden');
                    googleModal.classList.remove('flex');
                }
            });
        }

        // Google Identity Services (GSI) One-Tap / ID Token Handler
        window.handleGoogleCredentialResponse = function(response) {
            if (response && response.credential) {
                if (overlay) {
                    if (loadingText) loadingText.textContent = 'Verifying Google credentials…';
                    overlay.classList.remove('hidden');
                    overlay.classList.add('flex');
                }
                window.location.href = '/auth_callback.php#id_token=' + encodeURIComponent(response.credential);
            }
        };

        window.addEventListener('load', function() {
            if (googleClientId && window.google && window.google.accounts && window.google.accounts.id) {
                try {
                    window.google.accounts.id.initialize({
                        client_id: googleClientId,
                        callback: handleGoogleCredentialResponse,
                        auto_select: false,
                        cancel_on_tap_outside: true,
                        hd: 'navotaspolytechniccollege.edu.ph'
                    });
                    window.google.accounts.id.prompt();
                } catch (e) {
                    console.warn('[Google GSI Notice]', e);
                }
            }
        });

        const toggleCustomBtn = document.getElementById('toggle-custom-google');
        const customBox = document.getElementById('custom-google-box');
        if (toggleCustomBtn && customBox) {
            toggleCustomBtn.addEventListener('click', () => {
                customBox.classList.toggle('hidden');
                const inp = document.getElementById('custom-google-email');
                if (!customBox.classList.contains('hidden') && inp) inp.focus();
            });
        }

        function executeGoogleLogin(email, name, id) {
            if (googleModal) {
                googleModal.classList.add('hidden');
                googleModal.classList.remove('flex');
            }
            if (overlay) {
                if (loadingText) loadingText.textContent = 'Signing in as ' + (name || email) + '…';
                overlay.classList.remove('hidden');
                overlay.classList.add('flex');
            }

            // Real MySQL direct session creation via form POST
            const ident = document.getElementById('identifier');
            const form = document.getElementById('login-form');
            if (ident && form) {
                ident.value = email;
                setTimeout(() => {
                    form.submit();
                }, 300);
            }
        }

        document.querySelectorAll('.google-acct-item').forEach(el => {
            el.addEventListener('click', () => {
                const email = el.getAttribute('data-email');
                const name = el.getAttribute('data-name');
                const id = el.getAttribute('data-id');
                executeGoogleLogin(email, name, id);
            });
        });

        const submitCustomBtn = document.getElementById('submit-custom-google');
        if (submitCustomBtn) {
            submitCustomBtn.addEventListener('click', () => {
                const inp = document.getElementById('custom-google-email');
                const val = (inp && inp.value || '').trim();
                if (!val || !val.includes('@')) {
                    alert('Please enter a valid Gmail address.');
                    return;
                }
                executeGoogleLogin(val, val.split('@')[0]);
            });
        }

        // Dynamic Gmail Auto-Detection: Hide password field and show auto-login mode
        const identifierInp = document.getElementById('identifier');
        const pwdGroup = document.getElementById('password-group');
        const pwdInp = document.getElementById('password');
        const gmailBadge = document.getElementById('gmail-auto-badge');
        const submitBtnText = document.getElementById('submit-btn-text');
        const submitBtnIcon = document.getElementById('submit-btn-icon');

        function updateLoginMode() {
            if (!identifierInp) return;
            const val = identifierInp.value.trim().toLowerCase();
            const isEmail = val.includes('@');
            if (isEmail) {
                if (pwdGroup) pwdGroup.classList.add('hidden');
                if (pwdInp) pwdInp.required = false;
                if (gmailBadge) gmailBadge.classList.remove('hidden');
                if (submitBtnText) submitBtnText.textContent = '⚡ Instant Auto-Login (Walang Password)';
                if (submitBtnIcon) submitBtnIcon.textContent = 'bolt';
            } else {
                if (pwdGroup) pwdGroup.classList.remove('hidden');
                if (gmailBadge) gmailBadge.classList.add('hidden');
                if (submitBtnText) submitBtnText.textContent = 'Sign In Directly';
                if (submitBtnIcon) submitBtnIcon.textContent = 'login';
            }
        }

        if (identifierInp) {
            identifierInp.addEventListener('input', updateLoginMode);
            identifierInp.addEventListener('change', updateLoginMode);
            // Run on initial load in case browser autofilled
            updateLoginMode();
        }

        // Initialize Cinematic 3D Login Hero Scene
        document.addEventListener('DOMContentLoaded', function () {
            if (window.npcThree && typeof window.npcThree.initLoginHero === 'function') {
                window.npcThree.initLoginHero('login-hero-stage');
            }
        });
    </script>
</body>
